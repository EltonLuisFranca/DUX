{
  "name": "dux",
  "version": "1.0.3",
  "description": "",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:publish": "electron-vite build && electron-builder --publish always"
  },
  "keywords": [],
  "author": "Uzuno",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "build": {
    "appId": "com.eltonfranca.dux",
    "productName": "DUX",
    "files": [
      "out/**/*",
      "bridge/**/*",
      "!bridge/node_modules/node-pty/build/**/*.o",
      "!bridge/node_modules/node-pty/build/**/*.node.obj"
    ],
    "asarUnpack": [
      "bridge/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "pacman",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Elton Franca"
    },
    "publish": {
      "provider": "github",
      "owner": "EltonLuisFranca",
      "repo": "DUX"
    }
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  }
}
