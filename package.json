{
  "name": "dux",
  "version": "1.2.5",
  "description": "",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:publish": "electron-vite build && electron-builder --publish always"
  },
  "keywords": [],
  "author": "Uzuno",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "build": {
    "appId": "com.eltonfranca.dux",
    "productName": "DUX",
    "protocols": {
      "name": "DUX",
      "schemes": [
        "dux"
      ]
    },
    "files": [
      "out/**/*",
      "bridge/**/*",
      "!bridge/node_modules/node-pty/build/**/*.o",
      "!bridge/node_modules/node-pty/build/**/*.node.obj",
      "!node_modules/nodejs-whisper/cpp/whisper.cpp/{examples,tests,src,include,ggml,models,samples,bindings,grammars}/**/*",
      "!node_modules/nodejs-whisper/cpp/whisper.cpp/build/**/*.o",
      "!node_modules/nodejs-whisper/cpp/whisper.cpp/build/CMakeFiles/**/*",
      "!node_modules/nodejs-whisper/cpp/whisper.cpp/build/**/{test-*,bench,main,parakeet-*}",
      "!node_modules/nodejs-whisper/cpp/whisper.cpp/.git/**/*"
    ],
    "asarUnpack": [
      "bridge/**/*",
      "node_modules/nodejs-whisper/cpp/whisper.cpp/build/bin/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "pacman"
      ],
      "category": "Development",
      "maintainer": "Elton Franca"
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify",
        "libappindicator-gtk3"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "EltonLuisFranca",
      "repo": "DUX"
    }
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "laravel-echo": "^1.19.0",
    "marked": "^18.0.11",
    "nodejs-whisper": "^0.3.1",
    "pusher-js": "^8.6.0",
    "turndown": "^7.2.4",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  }
}
